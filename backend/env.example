# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default model
# OPENAI_MODEL=gpt-4o

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///./tutor.db
SQLITE_PATH=agentic_tutor.db

# Vector Store Configuration (Local)
VECTOR_DB_PATH=./chroma_db

# ChromaDB Cloud Configuration (for ChromaDB Cloud managed service)
# Set USE_CLOUD_CHROMA=true to use ChromaDB Cloud instead of local
USE_CLOUD_CHROMA=false
CHROMA_API_KEY=your_chroma_cloud_api_key_here
CHROMA_TENANT=your-tenant-id-here
CHROMA_DATABASE=your-database-name-here

# Redis Configuration (for session memory)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# CORS Configuration (Frontend URL for production)
# For local dev: http://localhost:8080
# For production: https://agentic-ai-tutor-eight.vercel.app
FRONTEND_URL=http://localhost:8080

# PDF Parser Service (nlm-ingestor Docker service)
# For local: http://127.0.0.1:5010/api/parseDocument?renderFormat=all&useNewIndentParser=true
# For Railway: http://nlm-ingestor-service.railway.internal:5001/api/parseDocument?renderFormat=all&useNewIndentParser=true
# Or use public URL if exposed: http://your-nlm-ingestor.up.railway.app/api/parseDocument?renderFormat=all&useNewIndentParser=true
LLMSHERPA_API_URL=http://127.0.0.1:5010/api/parseDocument?renderFormat=all&useNewIndentParser=true

